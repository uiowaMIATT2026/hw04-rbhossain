<?xml version="1.0" encoding="utf-8"?>
<executable>
    <category>MIATT.HW04.rbhossain</category>
    <title>SimpleThreshold</title>
    <description>Thresholds an image: pixels in [lowThreshold, highThreshold] get insideValue, all others get outsideValue.</description>
    <version>1.0</version>
    <contributor>Raisa Hossain (University of Iowa)</contributor>
    <acknowledgements>ITK BinaryThresholdImageFilter, SlicerExecutionModel</acknowledgements>

    <parameters>
        <label>IO</label>
        <description>Input/output parameters</description>
        <image>
            <name>inputVolume</name>
            <longflag>inputVolume</longflag>
            <label>Input Volume</label>
            <channel>input</channel>
            <description>Input volume to be thresholded</description>
        </image>
        <image>
            <name>outputVolume</name>
            <longflag>outputVolume</longflag>
            <label>Output Volume</label>
            <channel>output</channel>
            <description>Output thresholded image</description>
        </image>
    </parameters>

    <parameters>
        <label>Threshold Parameters</label>
        <description>Parameters for thresholding</description>
        <double>
            <name>lowThreshold</name>
            <longflag>lowThreshold</longflag>
            <description>Lower threshold value</description>
            <label>Low Threshold</label>
            <default>50</default>
        </double>
        <double>
            <name>highThreshold</name>
            <longflag>highThreshold</longflag>
            <description>Upper threshold value</description>
            <label>High Threshold</label>
            <default>100</default>
        </double>
        <double>
            <name>outsideValue</name>
            <longflag>outsideValue</longflag>
            <description>Value for pixels outside [low, high]</description>
            <label>Outside Value</label>
            <default>0</default>
        </double>
        <double>
            <name>insideValue</name>
            <longflag>insideValue</longflag>
            <description>Value for pixels inside [low, high]</description>
            <label>Inside Value</label>
            <default>255</default>
        </double>
    </parameters>
</executable>
